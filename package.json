{
  "name": "anchit-cv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run parse-tex && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "parse-tex": "node scripts/parse-tex.js",
    "compile-pdf": "docker run --rm -v \"$(pwd)\":/app -w /app texlive/texlive pdflatex -interaction=nonstopmode anchit-resume.tex && cp anchit-resume.pdf public/anchit-resume.pdf && rm -f anchit-resume.aux anchit-resume.log anchit-resume.out anchit-resume.pdf"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
